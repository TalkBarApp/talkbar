---
import type { Language } from '../i18n';
import { t } from '../i18n';
import { Icon } from 'astro-icon/components';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const stats = [
  { num: '0', label: t(lang, 'social.stat.bots'), icon: 'lucide:message-square-off' },
  { num: '1', label: t(lang, 'social.stat.mode'), icon: 'lucide:lock-keyhole' },
  { num: '5', label: t(lang, 'social.stat.pillars'), icon: 'lucide:route' },
  { num: 'AI', label: t(lang, 'social.stat.ai'), icon: 'lucide:brain' },
];

const terms = [
  'social.term.prepare',
  'social.term.capture',
  'social.term.assist',
  'social.term.remember',
  'social.term.act',
  'social.term.localMode',
  'social.term.ollama',
  'social.term.byok',
  'social.term.sourceBacked',
  'social.term.botFree',
];
---
<section class="section-pro section-pro-alt relative py-14 sm:py-16 lg:py-20 bg-sunken overflow-hidden">
  <div class="container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-9 sm:mb-10">
      {stats.map(({ num, label, icon }) => (
        <div class="panel-pro p-4 sm:p-5 text-left">
          <Icon name={icon} width="18" height="18" class="text-primary mb-3" />
          <div class="font-display text-3xl sm:text-4xl leading-none mb-1.5">{num}</div>
          <div class="text-[11px] font-mono uppercase tracking-[0.15em] text-muted-foreground">{label}</div>
        </div>
      ))}
    </div>

    <div class="text-center mb-6">
      <span class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-primary">
        <Icon name="lucide:shield-check" width="13" height="13" class="text-ps-green" />
        {t(lang, 'social.antibot')}
      </span>
    </div>

    <div class="panel-pro overflow-hidden px-0 py-4 [mask-image:linear-gradient(90deg,transparent,black_8%,black_92%,transparent)]">
      <div class="flex items-center gap-10 sm:gap-14 animate-marquee-slow w-max">
        {[0, 1].map(() => (
          <>
            {terms.map((key) => (
              <span class="font-display text-2xl sm:text-3xl text-foreground/30 whitespace-nowrap">{t(lang, key)}</span>
            ))}
          </>
        ))}
      </div>
    </div>
  </div>
</section>
