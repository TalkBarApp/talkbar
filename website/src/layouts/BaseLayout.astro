---
import { t, getTranslations, type Language } from '../i18n';
import { BUILD_DOMAIN, IS_PREVIEW_BUILD, CURRENT_CONFIG, ENGLISH_CROSS_LINK, ENGLISH_SITE_URL, getLocaleUrl } from '../i18n/domains';
import SiteModals from '../components/SiteModals.tsx';
import ScrollToTop from '../components/ScrollToTop.astro';
import { SITE_CONFIG } from '../lib/siteConfig';
import { DOWNLOAD_LINK_WINDOWS, DOWNLOAD_LINK_MAC } from '../lib/download';
import 'react-medium-image-zoom/dist/styles.css';
import '../styles/global.css';

const ACTIVE_LANGUAGES: Language[] = CURRENT_CONFIG.languages;
// True for every non-production build (English preview + Russian preview-ru).
const isPreviewBuild = IS_PREVIEW_BUILD;

interface Props {
  lang: Language;
  title: string;
  description: string;
  // Optional social-card / structured-data variants. Fall back to the page
  // title/description when not provided, so callers that only pass those two
  // are unaffected. Used by the homepage to keep <title> (longer, keyword-rich)
  // distinct from the og/twitter title and to give JSON-LD its own description.
  ogTitle?: string;
  ogDescription?: string;
  jsonLdDescription?: string;
  /** Keep the page out of search results (404). Drops canonical, hreflang and
      the app's structured data too. */
  noindex?: boolean;
  /** Add the site-wide WebSite and Organization schema (homepage only). */
  siteSchema?: boolean;
}

const {
  lang,
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  jsonLdDescription = description,
  noindex = false,
  siteSchema = false,
} = Astro.props;

const canonical = Astro.url.href;
const siteUrl = new URL('/', Astro.site ?? Astro.url).href;
const ogImage = new URL('/og/talkbar-og.png', Astro.site ?? Astro.url).href;
const ogImageAlt = t(lang, 'meta.ogImageAlt');
const OG_LOCALES: Record<Language, string> = { en: 'en_US', es: 'es_ES', ru: 'ru_RU', uk: 'uk_UA' };
const isDefaultLocale = (l: Language) => l === CURRENT_CONFIG.defaultLocale;

const publisher = {
  '@type': 'Organization',
  name: 'TalkBar',
  url: siteUrl,
  logo: new URL('/web-app-manifest-512x512.png', siteUrl).href,
};

// Same platforms as the docs (docs/composables/useDocsSeo.ts), so the product
// description stays the same as Mac support arrives.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'TalkBar',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'AI meeting notes',
  operatingSystem: 'Windows, macOS',
  downloadUrl: DOWNLOAD_LINK_WINDOWS,
  description: jsonLdDescription,
  url: canonical,
  image: ogImage,
  screenshot: ogImage,
  publisher,
  inLanguage: lang,
  featureList: [1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => t(lang, `meta.feature.${n}`)),
};

const siteSchemas = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'TalkBar', url: siteUrl, inLanguage: lang },
  { '@context': 'https://schema.org', ...publisher },
];
---
<!doctype html>
<html lang={lang} class="color-theme-blue">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Responsive nav label (short on md, full label on lg+). Inlined in <head>
        so it applies at first paint — even before the bundled stylesheet loads
        in dev — preventing a flash of the wrong label on page load. */}
    <style is:inline>
      .nav-label-full { display: none; }
      @media (min-width: 1024px) {
        .nav-label-short { display: none; }
        .nav-label-full { display: inline; }
      }
    </style>
    <title>{title}</title>
    <meta name="description" content={description} />
    {(isPreviewBuild || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" data-active-favicon />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" data-active-favicon-png />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" data-active-favicon-ico />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" data-active-apple-touch-icon />
    <link rel="manifest" href="/site.webmanifest" data-active-manifest />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#054df6" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="TalkBar" />
    <meta property="og:locale" content={OG_LOCALES[lang] ?? lang} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Urbanist and Hanken Grotesk have no Cyrillic, so the Russian site loads
        only Onest (headings and body) and JetBrains Mono. */}
    <link href={lang === 'ru'
      ? 'https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap'
      : 'https://fonts.googleapis.com/css2?family=Urbanist:wght@300;400;500;600;700&family=Onest:wght@300;400;500;600&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap'} rel="stylesheet" />
    {/* The flag font only draws the language cross-link, which English builds do not show. */}
    {ENGLISH_CROSS_LINK && <link rel="preload" href="/TwemojiCountryFlags.woff2" as="font" type="font/woff2" crossorigin />}

    {!noindex && ACTIVE_LANGUAGES.map((l) => (
      <link rel="alternate" hreflang={l} href={isDefaultLocale(l) ? canonical : getLocaleUrl(l)} />
    ))}
    {/* English is served at the root of its own domain, so a non-English build
        points x-default at the same path on the English site. */}
    {!noindex && <link rel="alternate" hreflang="x-default" href={isDefaultLocale('en') ? canonical : new URL(Astro.url.pathname, ENGLISH_SITE_URL).href} />}

    <!-- JSON-LD Structured Data -->
    {!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(appSchema)} />}
    {siteSchema && siteSchemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <script is:inline>
      const systemThemeQuery = window.matchMedia('(prefers-color-scheme: dark)');
      const applySystemAsset = (selector, path, themeName) => {
        const link = document.querySelector(selector);
        if (!(link instanceof HTMLLinkElement)) return;

        const nextLink = link.cloneNode(false);
        const cacheKey = themeName === 'dark' ? 'theme=dark' : 'theme=light';
        nextLink.setAttribute('href', `${path}?${cacheKey}`);
        link.replaceWith(nextLink);
      };

      const updateSystemThemeIcons = () => {
        const isDark = systemThemeQuery.matches;
        const themeName = isDark ? 'dark' : 'light';
        const systemIconAssets = [
          { selector: 'link[data-active-favicon]', light: '/favicon.svg', dark: '/dark/favicon.svg' },
          { selector: 'link[data-active-favicon-png]', light: '/favicon-96x96.png', dark: '/dark/favicon-96x96.png' },
          { selector: 'link[data-active-favicon-ico]', light: '/favicon.ico', dark: '/dark/favicon.ico' },
          { selector: 'link[data-active-apple-touch-icon]', light: '/apple-touch-icon.png', dark: '/dark/apple-touch-icon.png' },
          { selector: 'link[data-active-manifest]', light: '/site.webmanifest', dark: '/dark/site.webmanifest' },
        ];

        systemIconAssets.forEach(({ selector, light, dark }) => {
          applySystemAsset(selector, isDark ? dark : light, themeName);
        });
      };

      updateSystemThemeIcons();
      systemThemeQuery.addEventListener('change', updateSystemThemeIcons);

      const theme = localStorage.getItem('theme') ||
        (systemThemeQuery.matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
      const colorTheme = localStorage.getItem('colorTheme') || 'blue';
      document.documentElement.classList.toggle('color-theme-blue', colorTheme !== 'warm');
      if (colorTheme === 'warm') {
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#d58458');
      }
    </script>
    <script is:inline defer data-domain={BUILD_DOMAIN === 'preview' ? 'preview.talkbar.app' : BUILD_DOMAIN === 'preview-ru' ? 'preview.talkbar.ru' : BUILD_DOMAIN === 'prod-ru' ? 'talkbar.ru' : 'talkbar.app'} src="https://stats.pastebar.app/js/script.js"></script>
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-lg focus:text-sm focus:font-semibold focus:shadow-lg">
      {t(lang, 'a11y.skipToContent')}
    </a>
    <slot />

    <ScrollToTop lang={lang} />

    <SiteModals
      client:load
      lang={lang}
      translations={getTranslations(lang)}
      earlyAccessSubscribeUrl={SITE_CONFIG.earlyAccessSubscribeUrl}
      contactFormUrl={SITE_CONFIG.contactFormUrl}
      contactEmail={SITE_CONFIG.contactEmail}
    />

    <script is:inline>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));
    </script>
    <script
      is:inline
      define:vars={{
        tbCfg: {
          previewModalOnDownload: SITE_CONFIG.previewModalOnDownload,
          downloadWin: DOWNLOAD_LINK_WINDOWS,
          downloadMac: DOWNLOAD_LINK_MAC,
        },
      }}
    >
      // The footer Contact link always opens the contact modal. When the preview
      // modal is on, download CTAs open the "early access" modal too; when off, they
      // navigate to the real platform download. One delegated listener covers every
      // page and React-rendered link.
      (function () {
        if (window.__talkbarModalTriggers) return;
        window.__talkbarModalTriggers = true;

        // Plausible custom-event queue stub: buffers events fired before the
        // deferred analytics script finishes loading (e.g. very fast clicks).
        window.plausible = window.plausible || function () {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };

        if (!tbCfg.previewModalOnDownload) {
          var ua = (navigator.userAgent || '').toLowerCase();
          var url = ua.indexOf('mac') !== -1 && tbCfg.downloadMac ? tbCfg.downloadMac : tbCfg.downloadWin;
          document.querySelectorAll('[data-download-link]').forEach(function (el) {
            if (el instanceof HTMLAnchorElement) el.href = url;
          });
        }

        function trigger(name, eventName) {
          // Buffer the request in case the React island has not hydrated yet.
          window.__talkbarPendingModal = name;
          window.dispatchEvent(new CustomEvent(eventName));
        }

        document.addEventListener('click', function (e) {
          var target = e.target instanceof Element ? e.target : null;
          if (!target) return;

          var downloadEl = target.closest('[data-download-link]');
          if (downloadEl) {
            // Custom Plausible goal: fires for every download CTA click, in both
            // the real-download and early-access-modal modes. Covers the footer
            // download link and React-rendered Navbar buttons too.
            window.plausible('Download Button Click');
          }

          if (tbCfg.previewModalOnDownload && downloadEl) {
            e.preventDefault();
            trigger('early-access', 'talkbar:open-early-access');
            return;
          }

          if (target.closest('[data-contact-link]')) {
            e.preventDefault();
            trigger('contact', 'talkbar:open-contact');
          }
        });
      })();
    </script>
  </body>
</html>
