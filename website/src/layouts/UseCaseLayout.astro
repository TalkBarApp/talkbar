---
import { t, type Language } from '../i18n';
import { getTranslations } from '../i18n';
import { ENGLISH_CROSS_LINK } from '../i18n/domains';
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.tsx';
import StickyDownloadBar from '../components/StickyDownloadBar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Language;
  title: string;
  description: string;
  breadcrumb: {
    name: string;
    url: string;
  };
}

const { lang, title, description, breadcrumb } = Astro.props;
const translations = getTranslations(lang);

const siteUrl = new URL('/', Astro.url).origin;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'breadcrumb.home'), item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: breadcrumb.name, item: breadcrumb.url },
  ],
};
---
<BaseLayout lang={lang} title={title} description={description}>
  <Navbar client:load lang={lang} translations={translations} englishUrl={ENGLISH_CROSS_LINK} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  <main id="main-content">
    <slot />
  </main>
  <StickyDownloadBar lang={lang} />
  <Footer lang={lang} />
</BaseLayout>
