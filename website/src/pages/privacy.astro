---
import { t } from '../i18n';
import { CURRENT_CONFIG } from '../i18n/domains';
import UseCaseLayout from '../layouts/UseCaseLayout.astro';
import DataFlow from '../components/DataFlow.astro';
import CTASection from '../components/CTASection.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Screenshot from '../components/ui/Screenshot.astro';
import { Icon } from 'astro-icon/components';

const lang = CURRENT_CONFIG.defaultLocale;
const siteUrl = new URL('/', Astro.url).origin;

const staysLocal = [
  'privacyPage.local.item1',
  'privacyPage.local.item2',
  'privacyPage.local.item3',
  'privacyPage.local.item4',
];

const canLeave = [
  'privacyPage.leaves.item1',
  'privacyPage.leaves.item2',
  'privacyPage.leaves.item3',
  'privacyPage.leaves.item4',
];

// Private AI Mode: what it covers, how to turn it on, what it is not.
const modeColumns = [
  { icon: 'lucide:shield-check', title: 'privacyPage.mode.covers.title', items: [1, 2, 3].map((n) => `privacyPage.mode.covers.${n}`) },
  { icon: 'lucide:toggle-right', title: 'privacyPage.mode.on.title', items: [1, 2, 3].map((n) => `privacyPage.mode.on.${n}`) },
  { icon: 'lucide:circle-slash', title: 'privacyPage.mode.not.title', items: [1, 2, 3].map((n) => `privacyPage.mode.not.${n}`) },
];

// The five AI routes; the first two are the ones Private AI Mode allows.
const paths = [1, 2, 3, 4, 5].map((n) => ({
  path: `privacyPage.paths.row${n}.path`,
  where: `privacyPage.paths.row${n}.where`,
  leaves: `privacyPage.paths.row${n}.leaves`,
  local: n <= 2,
}));

const network = [1, 2, 3, 4, 5, 6].map((n) => ({
  when: `privacyPage.network.row${n}.when`,
  what: `privacyPage.network.row${n}.what`,
  control: `privacyPage.network.row${n}.control`,
}));

const controls = [
  { icon: 'lucide:user-x', key: 'speaker' },
  { icon: 'lucide:disc-3', key: 'audio' },
  { icon: 'lucide:lock-keyhole', key: 'sessionOnly' },
  { icon: 'lucide:list-checks', key: 'review' },
  { icon: 'lucide:file-scan', key: 'tempScan' },
  { icon: 'lucide:folder-tree', key: 'workspaces' },
  { icon: 'lucide:hard-drive', key: 'files' },
  { icon: 'lucide:languages', key: 'translation' },
];

const faqItems = [
  { q: 'faq.capture.q', a: 'faq.capture.a' },
  { q: 'faq.privateMode.q', a: 'faq.privateMode.a' },
  { q: 'faq.local.q', a: 'faq.local.a' },
  { q: 'faq.external.q', a: 'faq.external.a' },
  { q: 'faq.delete.q', a: 'faq.delete.aPrivacyPage' },
  { q: 'faq.documents.q', a: 'faq.documents.a' },
  { q: 'faq.consent.q', a: 'faq.consent.a' },
];
---
<UseCaseLayout
  lang={lang}
  title={t(lang, 'privacyPage.meta.title')}
  description={t(lang, 'privacyPage.meta.description')}
  breadcrumb={{ name: t(lang, 'privacyPage.eyebrow'), url: `${siteUrl}/privacy/` }}
>
  <section class="section-pro relative overflow-hidden pt-28 sm:pt-32 lg:pt-40 pb-16 sm:pb-20 lg:pb-24">
    <div class="container relative z-10 text-center">
      <div class="transition-transform">
        <span class="eyebrow ctr">{t(lang, 'privacyPage.eyebrow')}</span>
        <h1 class="font-display text-[clamp(40px,5.6vw,76px)] leading-[1.02] tracking-[-0.025em] mt-6 [text-wrap:balance]">
          {t(lang, 'privacyPage.headline')}
          <br /><span class="accent-phrase">{t(lang, 'privacyPage.accent')}</span>
        </h1>
        <p class="mx-auto mt-8 max-w-[58ch] text-[clamp(18px,1.4vw,20px)] leading-[1.62] text-muted-foreground">
          {t(lang, 'privacyPage.sub')}
        </p>
      </div>
    </div>
  </section>

  <section class="section-pro surface-ink section-pad-sm">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2 class="h2-serif text-ink-foreground">
          {t(lang, 'privacyFlow.title')} <span class="it inline">{t(lang, 'privacyFlow.titleAccent')}</span> {t(lang, 'privacyFlow.titleEnd')}
        </h2>
        <p class="lead-serif ctr mt-5 max-w-[60ch]">{t(lang, 'privacyFlow.sub')}</p>
      </div>
      <div class="max-w-4xl mx-auto">
        <DataFlow lang={lang} />
      </div>
    </div>
  </section>

  <section class="section-pro section-pad" id="private-ai-mode">
    <div class="container">
      <SectionHeader
        eyebrow={t(lang, 'privacyPage.mode.eyebrow')}
        headline={t(lang, 'privacyPage.mode.headline')}
        accent={t(lang, 'privacyPage.mode.accent')}
        subhead={t(lang, 'privacyPage.mode.sub')}
      />

      <div class="grid grid-cols-1 lg:grid-cols-[1.18fr_0.82fr] gap-6 lg:gap-10 items-start">
        <Screenshot lang={lang} id="private-ai" />

        <div class="pv-mode">
          {modeColumns.map(({ icon, title, items }) => (
            <div class="pv-mode-col">
              <h3>
                <span class="icon-mark"><Icon name={icon} width="18" height="18" is:inline /></span>
                {t(lang, title)}
              </h3>
              <ul>
                {items.map((key) => <li>{t(lang, key)}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-pro section-pro-alt section-pad">
    <div class="container">
      <SectionHeader
        eyebrow={t(lang, 'privacyPage.paths.eyebrow')}
        headline={t(lang, 'privacyPage.paths.headline')}
        accent={t(lang, 'privacyPage.paths.accent')}
        subhead={t(lang, 'privacyPage.paths.sub')}
      />

      <div class="pv-table-wrap">
        <table class="pv-table">
          <thead>
            <tr>
              <th>{t(lang, 'privacyPage.paths.col.path')}</th>
              <th>{t(lang, 'privacyPage.paths.col.where')}</th>
              <th>{t(lang, 'privacyPage.paths.col.leaves')}</th>
            </tr>
          </thead>
          <tbody>
            {paths.map(({ path, where, leaves, local }) => (
              <tr class:list={[local && 'pv-local']}>
                <td>
                  {t(lang, path)}
                  {local && (
                    <span class="pv-pill">
                      <Icon name="lucide:shield-check" width="12" height="12" is:inline />
                      {t(lang, 'privacyPage.mode.eyebrow')}
                    </span>
                  )}
                </td>
                <td>{t(lang, where)}</td>
                <td>{t(lang, leaves)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pv-note">{t(lang, 'privacyPage.paths.note')}</p>
    </div>
  </section>

  <section class="section-pro section-pad-sm">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-4xl mx-auto">
        <div class="panel-pro p-6">
          <div class="inline-flex items-center gap-2 label text-[hsl(var(--accent-text))] mb-4">
            <Icon name="lucide:hard-drive" width="14" height="14" />
            {t(lang, 'privacyPage.local.title')}
          </div>
          <ul class="space-y-3">
            {staysLocal.map((key) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-foreground/85">
                <Icon name="lucide:check" width="15" height="15" class="text-ps-green mt-0.5 flex-shrink-0" />
                {t(lang, key)}
              </li>
            ))}
          </ul>
        </div>
        <div class="panel-pro p-6">
          <div class="inline-flex items-center gap-2 label text-[hsl(var(--accent-text))] mb-4">
            <Icon name="lucide:file-output" width="14" height="14" />
            {t(lang, 'privacyPage.leaves.title')}
          </div>
          <ul class="space-y-3">
            {canLeave.map((key) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-foreground/85">
                <Icon name="lucide:arrow-up-right" width="15" height="15" class="text-primary mt-0.5 flex-shrink-0" />
                {t(lang, key)}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="max-w-4xl mx-auto mt-14">
        <h2 class="h2-serif text-[clamp(26px,3vw,36px)]">{t(lang, 'privacyPage.network.title')}</h2>
        <p class="lead-serif mt-3 max-w-[60ch]">{t(lang, 'privacyPage.network.sub')}</p>
        <div class="pv-table-wrap mt-8">
          <table class="pv-table">
            <thead>
              <tr>
                <th>{t(lang, 'privacyPage.network.col.when')}</th>
                <th>{t(lang, 'privacyPage.network.col.what')}</th>
                <th>{t(lang, 'privacyPage.network.col.control')}</th>
              </tr>
            </thead>
            <tbody>
              {network.map(({ when, what, control }) => (
                <tr>
                  <td>{t(lang, when)}</td>
                  <td>{t(lang, what)}</td>
                  <td>{t(lang, control)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pro section-pro-alt section-pad">
    <div class="container">
      <SectionHeader
        eyebrow={t(lang, 'privacyPage.controls.eyebrow')}
        headline={t(lang, 'privacyPage.controls.headline')}
        accent={t(lang, 'privacyPage.controls.accent')}
        subhead={t(lang, 'privacyPage.controls.sub')}
      />

      <div class="pv-grid">
        {controls.map(({ icon, key }) => (
          <div class="panel-pro pv-tile">
            <span class="icon-line pv-tile-ic" aria-hidden="true"><Icon name={icon} width="32" height="32" is:inline /></span>
            <h3>{t(lang, `privacyPage.controls.${key}.title`)}</h3>
            <p>{t(lang, `privacyPage.controls.${key}.desc`)}</p>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-4xl mx-auto mt-10">
        <div class="panel-pro p-6">
          <div class="inline-flex items-center gap-2 label text-[hsl(var(--accent-text))] mb-3">
            <Icon name="lucide:sliders-horizontal" width="14" height="14" />
            {t(lang, 'privacyPage.retention.title')}
          </div>
          <p class="text-sm leading-relaxed text-muted-foreground">{t(lang, 'privacyPage.retention.desc')}</p>
        </div>
        <div class="panel-pro p-6">
          <div class="inline-flex items-center gap-2 label text-[hsl(var(--accent-text))] mb-3">
            <Icon name="lucide:scale" width="14" height="14" />
            {t(lang, 'privacyPage.consent.title')}
          </div>
          <p class="text-sm leading-relaxed text-muted-foreground">{t(lang, 'privacyPage.consent.desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pro section-pro-alt section-pad-sm">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-10 sm:mb-14">
        <h2 class="h2-serif">{t(lang, 'privacyPage.faqTitle')}</h2>
      </div>
      <div class="faq2 faq2-single max-w-3xl mx-auto">
        <div class="faq2-col">
          {faqItems.map(({ q, a }) => (
            <details>
              <summary>
                {t(lang, q)}
                <span class="pm" aria-hidden="true"></span>
              </summary>
              <p>{t(lang, a)}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTASection lang={lang} />
</UseCaseLayout>
