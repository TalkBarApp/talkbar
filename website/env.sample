# TalkBar website configuration — sample.
# Copy to `.env` (or export in CI) and adjust. All values are read at BUILD time
# and injected through the `define` block in astro.config.mjs, so they are
# available in both server-rendered Astro frontmatter and client React islands.
# Booleans: 1 or true = on; 0 or false = off.

# --- Build target ---------------------------------------------------------
# `preview` builds preview.talkbar.app (noindex) into dist-preview/.
# `preview-ru` builds preview.talkbar.ru (noindex) into dist-preview-ru/.
# `prod-ru` is reserved for a future live talkbar.ru build.
# Anything else builds the production site (www.talkbar.app) into dist-prod/.
BUILD_DOMAIN="prod"

# --- Download links -------------------------------------------------------
# Direct download URLs for the desktop app.
DOWNLOAD_LINK_WINDOWS="https://cdn.talkbar.app/TalkBar_x64-setup.exe"
DOWNLOAD_LINK_MAC=""

# --- Preview-launch modals ------------------------------------------------
# Toggle the "Get early access" modal on every download button.
#   1/true  -> download buttons open the early-access modal (use while there is no .exe).
#   0/false -> download buttons download the real app (platform-detected Win/Mac).
# Default: true.
PREVIEW_MODAL_ON_DOWNLOAD="true"

# Form endpoints default by build target:
#   prod       -> https://license.talkbar.app
#   preview    -> https://license.preview.talkbar.app
#   preview-ru -> https://license.preview.talkbar.ru
#   prod-ru    -> https://license.talkbar.ru
# In `astro dev`, blank values keep placeholder behaviour (shows success, sends
# nothing). Set these only to override the matching license-server defaults.
#
# Early access JSON body:
# { "email": "...", "source": "...", "locale": "en|ru", "referrer": "..." }
EARLY_ACCESS_SUBSCRIBE_URL=""

# Contact form JSON body includes name/email/message plus source, appLanguage,
# subject/category defaults, and subscribeUpdates from the visible checkbox.
CONTACT_FORM_URL=""

# Later standalone product-updates signup endpoint. Defaults to
# /api/subscriptions/product-updates on the matching license server for builds.
PRODUCT_UPDATES_SUBSCRIBE_URL=""

# Address used for mailto: fallbacks (footer Support / Contact links).
CONTACT_EMAIL="contact@talkbar.app"
