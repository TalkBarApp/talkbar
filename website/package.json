{
  "name": "talkbar-www",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321 --ignore-lock",
    "test": "vitest run",
    "build": "astro build",
    "build:preview": "cross-env BUILD_DOMAIN=preview astro build",
    "deploy:preview": "npm run build:preview && npx --yes wrangler pages deploy dist-preview --project-name talkbar-preview --branch preview",
    "dev:preview:ru": "cross-env BUILD_DOMAIN=preview-ru astro dev --port 4322 --ignore-lock",
    "dev:ru": "npm run dev:preview:ru",
    "build:preview:ru": "cross-env BUILD_DOMAIN=preview-ru astro build",
    "deploy:preview:ru": "npm run build:preview:ru && npx --yes wrangler pages deploy dist-preview-ru --project-name talkbar-preview-ru --branch preview",
    "preview": "astro preview",
    "tool.cli": "node tools/trim-image-border.mjs",
    "image:trim-border": "node tools/trim-image-border.mjs",
    "image:og": "node tools/og-image.mjs",
    "lint": "eslint .",
    "check": "astro check"
  },
  "overrides": {
    "vite": "^8",
    "volar-service-yaml": "0.0.71"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/lucide": "^1.2.107",
    "@radix-ui/react-slot": "^1.2.4",
    "astro": "^7.3.1",
    "astro-icon": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-medium-image-zoom": "^5.4.5",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8",
    "vitest": "^4.1.6"
